# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: só no servidor (Vercel). Nunca coloque no código nem no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do app, sem barra no final (usada no link da equipe de limpeza)
APP_URL=https://seu-app.vercel.app
# production (padrão) ou staging. Em staging aparece a faixa "AMBIENTE DE TESTES".
APP_ENV=production
# Opcional. Liga a caixa de entrada do channel manager (/api/channel/inbox).
# Mínimo 16 caracteres. Gere com: openssl rand -hex 32
CHANNEL_INBOX_SECRET=
