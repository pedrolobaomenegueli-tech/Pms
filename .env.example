# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: só no servidor (Vercel). Nunca coloque no código nem no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo da rota /api/sync. Gere com: openssl rand -hex 32
SYNC_SECRET=
# URL pública do app, sem barra no final (usada nos links de exportação iCal)
APP_URL=https://seu-app.vercel.app
